# Copy to .env locally. Plain KEY=value; optional matching quotes; no shell expansion.
# Team platform token also authenticates the official Docker registry.
TEAM_ID=63
CTF_BASE=https://hackathon.in-cypher.com
CTF_TOKEN=

# Required for API-backed local practice and Day-1 arena images only.
# Use a provider API key. Codex/ChatGPT login tokens are NOT API keys.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Local defaults. Day 2 reads organiser-injected LLM_* values.
MAX_STEPS=40
MAX_SUBMISSIONS=3
